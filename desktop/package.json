{
  "name": "cloneme-desktop",
  "productName": "cloneME",
  "version": "0.1.0",
  "private": true,
  "description": "Talk with an AI version of someone you know",
  "author": "cloneME",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "release": "npm run build && electron-builder --win nsis --x64 --publish always"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.95.0",
    "electron-updater": "^6.8.11"
  }
}
