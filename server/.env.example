# --- Server ---
PORT=8787
# Public HTTPS URL of this server. Tavus calls ${PUBLIC_BASE_URL}/v1 as the custom LLM and fetches signed media from it.
PUBLIC_BASE_URL=https://cloneme.example.com
DATA_DIR=./data
NODE_ENV=production
# >= 32 random chars; signs app tokens and media links
SESSION_SECRET=
# >= 24 random chars; Tavus sends it as the Bearer key to the persona LLM endpoint
PERSONA_LLM_SHARED_SECRET=
OWNER_NAME=Your Name
# Optional: choose the owner's invite code (otherwise one is generated and printed once at first start)
OWNER_INVITE_CODE=
MAX_CONCURRENT_SESSIONS=3
MAX_CALL_SECONDS=1800

# --- Vendor secrets (leave empty to run that vendor in mock mode) ---
TAVUS_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
LLM_API_KEY=
# Any OpenAI-compatible chat completions API
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# --- Vendor ids (written by the setup scripts; set here to pin them) ---
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
ELEVENLABS_VOICE_ID=
TAVUS_WEBHOOK_SECRET=

# Force every vendor into mock mode
MOCK_MODE=false

# --- Guided setup (the in-app wizard) ---
# One-time token that lets the owner claim a fresh server from the app. Render's blueprint generates it.
SETUP_TOKEN=
# Set to true when DATA_DIR is on a persistent disk (reported to the app in step 3).
PERSISTENT_STORAGE=
# Link placed in invite messages (default: latest GitHub release).
INSTALLER_URL=
# Mock mode only: pretend ElevenLabs needs manual voice verification, to preview that step.
MOCK_REQUIRE_VERIFICATION=
